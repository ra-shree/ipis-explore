# %% Cell 1
import polars as pl

df = pl.read_parquet("../storage/processed/election_2079/1_koshi_province.parquet")
df.select('palika_id', 'district_name_en', 'total_votes', 'post_id').filter(pl.col('palika_id') == 5092, pl.col('total_votes') > 0, pl.col('post_id') == 3).head(5)

# %%
df = pl.read_parquet("../storage/processed/election_2079/1_koshi_province.parquet")
df.select('total_votes', 'palika_id', 'party_name_en', 'post_id').filter(pl.col('palika_id') == 5092, pl.col('total_votes') > 0).group_by('party_name_en', 'post_id').agg(pl.col('total_votes').sum()).filter(pl.col('total_votes')> 15000).sort("post_id")
# %%
df = pl.read_parquet("../storage/processed/election_2079/1_koshi_province.parquet")
df.filter(pl.col('post_id') == 3).select('total_votes').sum()
df.filter(pl.col('post_id') == 4).select('total_votes').sum()
# %%
(df.select('total_votes', 'palika_id', 'party_name_en', 'post_id')
    .filter(pl.col('palika_id') == 5092)
    .group_by('party_name_en', 'post_id')
    .agg(pl.col('total_votes').sum())
    .with_columns((pl.col('total_votes') / pl.col('total_votes').over('post_id')).alias('vote_ratio'), pl.col('total_votes').rank('ordinal',descending=True).over('post_id').alias('rank'))))
